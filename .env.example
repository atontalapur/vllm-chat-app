# Copy to .env and fill in. Never commit .env — it holds real secrets.

# --- Model serving (vllm) ---
# Pinned image tag. The bare vX.Y.Z tag is CUDA 13.0 and needs a recent driver
# (r580+); -cu129 is CUDA 12.9 and works on more rented GPU boxes. Check your
# box with `nvidia-smi` before changing this.
VLLM_IMAGE_TAG=v0.28.0-cu129

# Ungated model — no HF token needed. Swap for a gated model (e.g.
# meta-llama/Llama-3.1-8B-Instruct) and set HF_TOKEN below if you want the
# gated-model flow instead.
MODEL_ID=Qwen/Qwen2.5-7B-Instruct

# Only needed for gated models. Get one at https://huggingface.co/settings/tokens
# (read access is enough), after accepting the model's license on its HF page.
HF_TOKEN=

# Deliberately low so a small concurrent burst produces a VISIBLE queue-depth
# spike on the dashboard. This is demo-tuned, not a production value — raise it
# if you care about throughput rather than watching the queue.
VLLM_MAX_NUM_SEQS=4

# Fraction of GPU VRAM vLLM may claim. 0.90 is the vLLM default.
VLLM_GPU_MEMORY_UTILIZATION=0.90

# Context window cap. The model's own default is 32k, which on a 24GB card
# (RTX 3090, A10, L4) leaves little KV cache for concurrent sequences. 8192 is
# plenty for chat and frees memory for the queueing behaviour the dashboard
# shows. If vLLM refuses to start with a KV-cache error, lower this first.
VLLM_MAX_MODEL_LEN=8192

# --- Local development (no GPU) ---
# vLLM needs CUDA, so it cannot run on a Mac. For local dev the api talks to any
# OpenAI-compatible upstream instead; Ollama on Apple Silicon is Metal-accelerated
# and already speaks this protocol. Production leaves this unset and the api
# defaults to the in-compose vllm service.
#
#   VLLM_BASE_URL=http://host.docker.internal:11434/v1
#
# Use a NON-reasoning model locally. Reasoning models (e.g. qwen3.5) emit deltas
# with a `reasoning` field and empty `content`, so a content-only UI renders
# nothing until reasoning finishes — indistinguishable from a broken stream.
#   LOCAL_MODEL_ID=llama3.1:latest

# --- Application layer (api) ---
# Shared secret between ui and api. Generate one: openssl rand -hex 32
API_KEY=

# --- Dashboard (metrics) ---
# Never leave this as the admin/admin default.
GF_SECURITY_ADMIN_PASSWORD=
